#%Module######################################################################
##
##      METdataio
##
proc ModulesHelp { } {
  puts stderr "Sets up the paths and environment variables to use the METdataio-13.0.0.
     *** For help see the official MET webpage at http://www.dtcenter.org/met/users ***"
}

#module unload cray-libsci/24.07.0
module load intel/2025.2

prepend-path PATH /ncrc/proj/nggps_psd/Julie.Prestopnik/projects/miniconda/miniconda3/envs/metplus_v13.0_py3.14/bin
prepend-path PATH /usw/met/METdataio/METdataio-13.0.0/METdbLoad/ush
prepend-path PATH /usw/met/METdataio/METdataio-13.0.0/METdbLoad
prepend-path PATH /usw/met/METdataio/METdataio-13.0.0/METreformat
prepend-path PATH /usw/met/METdataio/METdataio-13.0.0/METreadnc/util
prepend-path PATH /usw/met/METdataio/METdataio-13.0.0/METreadnc
prepend-path PATH /usw/met/METdataio/METdataio-13.0.0
prepend-path PYTHONPATH /usw/met/METdataio/METdataio-13.0.0/METdbLoad/ush
prepend-path PYTHONPATH /usw/met/METdataio/METdataio-13.0.0/METdbLoad
prepend-path PYTHONPATH /usw/met/METdataio/METdataio-13.0.0/METreformat
prepend-path PYTHONPATH /usw/met/METdataio/METdataio-13.0.0/METreadnc/util
prepend-path PYTHONPATH /usw/met/METdataio/METdataio-13.0.0/METreadnc
prepend-path PYTHONPATH /usw/met/METdataio/METdataio-13.0.0
