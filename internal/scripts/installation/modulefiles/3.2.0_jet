#%Module######################################################################
##
##      METdataio
##
proc ModulesHelp { } {
  puts stderr "Sets up the paths and environment variables to use the METdataio-3.2.0.
     *** For help see the official MET webpage at http://www.dtcenter.org/met/users ***"
}

prereq intel/2024.2.1

prepend-path PATH /lfs6/HFIP/dtc-hurr/METplus/miniconda/miniconda3/envs/metplus_v6.1_py3.12/bin

prepend-path PATH /contrib/met/METdataio/METdataio-3.2.0/METdbLoad/ush
prepend-path PATH /contrib/met/METdataio/METdataio-3.2.0/METdbLoad
prepend-path PATH /contrib/met/METdataio/METdataio-3.2.0/METreformat
prepend-path PATH /contrib/met/METdataio/METdataio-3.2.0/METreadnc/util
prepend-path PATH /contrib/met/METdataio/METdataio-3.2.0/METreadnc
prepend-path PATH /contrib/met/METdataio/METdataio-3.2.0
prepend-path PYTHONPATH /contrib/met/METdataio/METdataio-3.2.0/METdbLoad/ush
prepend-path PYTHONPATH /contrib/met/METdataio/METdataio-3.2.0/METdbLoad
prepend-path PYTHONPATH /contrib/met/METdataio/METdataio-3.2.0/METreformat
prepend-path PYTHONPATH /contrib/met/METdataio/METdataio-3.2.0/METreadnc/util
prepend-path PYTHONPATH /contrib/met/METdataio/METdataio-3.2.0/METreadnc
prepend-path PYTHONPATH /contrib/met/METdataio/METdataio-3.2.0
