#%Module######################################################################
##
##      METdataio
##
proc ModulesHelp { } {
  puts stderr "Sets up the paths and environment variables to use the METdataio-3.2.0.
     *** For help see the official MET webpage at http://www.dtcenter.org/met/users ***"
}

module load compiler-rt/2024.0.1
module load tbb/2021.11
module load oclfpga/2024.0.0
module load compiler/2024.0.1
module load mkl/2024.0
module load mpi/2021.11

prepend-path PATH /atec/opt/atectest/METplus/miniconda/miniconda3/envs/metplus_v6.1_py3.12/bin

prepend-path PATH /atec/opt/atectest/METdataio/METdataio-3.2.0/METdbLoad/ush
prepend-path PATH /atec/opt/atectest/METdataio/METdataio-3.2.0/METdbLoad
prepend-path PATH /atec/opt/atectest/METdataio/METdataio-3.2.0/METreformat
prepend-path PATH /atec/opt/atectest/METdataio/METdataio-3.2.0/METreadnc/util
prepend-path PATH /atec/opt/atectest/METdataio/METdataio-3.2.0/METreadnc
prepend-path PATH /atec/opt/atectest/METdataio/METdataio-3.2.0
prepend-path PYTHONPATH /atec/opt/atectest/METdataio/METdataio-3.2.0/METdbLoad/ush
prepend-path PYTHONPATH /atec/opt/atectest/METdataio/METdataio-3.2.0/METdbLoad
prepend-path PYTHONPATH /atec/opt/atectest/METdataio/METdataio-3.2.0/METreformat
prepend-path PYTHONPATH /atec/opt/atectest/METdataio/METdataio-3.2.0/METreadnc/util
prepend-path PYTHONPATH /atec/opt/atectest/METdataio/METdataio-3.2.0/METreadnc
prepend-path PYTHONPATH /atec/opt/atectest/METdataio/METdataio-3.2.0
