#%Module######################################################################
##
##      METdataio
##
proc ModulesHelp { } {
  puts stderr "Sets up the paths and environment variables to use the METdataio-3.2.0.
     *** For help see the official MET webpage at http://www.dtcenter.org/met/users ***"
}

module unload cray-libsci/24.07.0
module load intel/2023.2.0

prepend-path PATH /ncrc/proj/nggps_psd/Julie.Prestopnik/projects/miniconda/miniconda3/envs/metplus_v6.1_py3.12/bin
prepend-path PATH /usw/met/METdataio/METdataio-3.2.0/METdbLoad/ush
prepend-path PATH /usw/met/METdataio/METdataio-3.2.0/METdbLoad
prepend-path PATH /usw/met/METdataio/METdataio-3.2.0/METreformat
prepend-path PATH /usw/met/METdataio/METdataio-3.2.0/METreadnc/util
prepend-path PATH /usw/met/METdataio/METdataio-3.2.0/METreadnc
prepend-path PATH /usw/met/METdataio/METdataio-3.2.0
prepend-path PYTHONPATH /usw/met/METdataio/METdataio-3.2.0/METdbLoad/ush
prepend-path PYTHONPATH /usw/met/METdataio/METdataio-3.2.0/METdbLoad
prepend-path PYTHONPATH /usw/met/METdataio/METdataio-3.2.0/METreformat
prepend-path PYTHONPATH /usw/met/METdataio/METdataio-3.2.0/METreadnc/util
prepend-path PYTHONPATH /usw/met/METdataio/METdataio-3.2.0/METreadnc
prepend-path PYTHONPATH /usw/met/METdataio/METdataio-3.2.0
